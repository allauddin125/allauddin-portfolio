# Contact form SMTP settings — used ONLY by the Netlify Function (server side).
# Copy to `.env` for local development (`netlify dev` loads it automatically),
# and add the same variables in Netlify: Site configuration → Environment variables.
#
# Never prefix these with VITE_ — VITE_ variables are bundled into the public website.
# For Gmail, SMTP_PASS must be a Google App Password, not your normal password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
TO_EMAIL=your-email@gmail.com
